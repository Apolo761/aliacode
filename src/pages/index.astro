---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import Arrow from '../components/Arrow.astro';
import Core from '../components/Core.astro';
const solutions = [
  { n: '01', kind: 'agents', title: 'Agentes de IA', text: 'Inteligência que entende o contexto, consulta suas informações e executa tarefas com os limites que sua operação precisa.', tags: ['Atendimento', 'Conhecimento', 'Operação'] },
  { n: '02', kind: 'flows', title: 'Automações inteligentes', text: 'Conecte sistemas e transforme processos repetitivos em fluxos que trabalham juntos. Menos trabalho manual, mais espaço para crescer.', tags: ['Integrações', 'Workflows', 'Produtividade'] },
  { n: '03', kind: 'software', title: 'Software sob medida', text: 'Da primeira ideia ao produto em operação. Plataformas, aplicações e ferramentas construídas em torno do seu negócio.', tags: ['Plataformas', 'Sistemas', 'Produtos digitais'] },
  { n: '04', kind: 'data', title: 'Inteligência sobre seus dados', text: 'Organize informações dispersas e transforme perguntas em respostas úteis. Dê à sua equipe clareza para decidir e agir.', tags: ['Dados', 'Análise', 'Decisão'] },
];
const steps = [
  ['Entender', 'Tudo começa pelo seu negócio.', 'Mapeamos a operação, os desafios e as oportunidades. Definimos o problema certo antes de escrever a primeira linha de código.'],
  ['Construir', 'Da hipótese ao que funciona.', 'Desenhamos a solução, validamos com quem vai usar e desenvolvemos em ciclos curtos, com entregas que você pode acompanhar.'],
  ['Evoluir', 'O lançamento é só o começo.', 'Colocamos a solução em operação e acompanhamos seu uso. Ajustamos, aprendemos e evoluímos junto com a sua empresa.'],
];
const questions = [
  ['O que a AliaCode desenvolve?', 'Desenvolvemos soluções de inteligência artificial e software sob medida para empresas: agentes, automações, integrações, plataformas e aplicações para organizar e utilizar dados. O escopo parte do desafio de cada negócio.'],
  ['Preciso saber exatamente o que quero construir?', 'Não. O trabalho pode começar pelo problema: uma tarefa que toma tempo, uma informação difícil de encontrar ou uma operação que precisa evoluir. A partir disso, desenhamos os caminhos possíveis.'],
  ['A solução pode se conectar aos sistemas que já uso?', 'Sim. Avaliamos as APIs, as permissões e as possibilidades de integração das ferramentas existentes para definir uma arquitetura compatível com a sua operação.'],
  ['Toda solução precisa de inteligência artificial?', 'Não. Escolhemos a tecnologia de acordo com o problema. Em alguns casos, uma boa integração ou um fluxo automatizado resolve melhor. A IA entra onde pode trazer valor ao projeto.'],
];
---
<Layout>
  <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
  <header class="site-header">
    <div class="nav-shell wrap">
      <a class="brand" href="#inicio" aria-label="AliaCode — início"><Logo /></a>
      <nav aria-label="Navegação principal" id="main-nav">
        <a href="#solucoes">Soluções</a><a href="#possibilidades">Na prática</a><a href="#processo">Como trabalhamos</a><a href="#sobre">A AliaCode</a>
      </nav>
      <a class="nav-cta" href="#solucoes">Explore as possibilidades <Arrow diagonal /></a>
      <button class="menu-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="main-nav"><span></span><span></span></button>
    </div>
  </header>
  <main id="conteudo">
    <section class="hero wrap" id="inicio" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot"></span> SOFTWARE HOUSE · AI FIRST</p>
        <h1 id="hero-title">Inteligência<br />artificial.<br /><span>Impacto real.</span></h1>
        <p class="hero-description">Transformamos desafios do seu negócio em soluções de IA. Da ideia ao software que faz a diferença no dia a dia.</p>
        <div class="hero-actions"><a class="button button-light" href="#solucoes">Conheça nossas soluções <Arrow /></a><a class="text-link" href="#processo">Como trabalhamos <span aria-hidden="true">↗</span></a></div>
      </div>
      <Core />
      <div class="hero-bottom"><span>TECNOLOGIA COM PROPÓSITO.</span><span>FEITA PARA O SEU NEGÓCIO.</span><a href="#solucoes" aria-label="Explorar soluções abaixo">ROLE PARA EXPLORAR <span aria-hidden="true">↓</span></a></div>
    </section>

    <section class="solutions section wrap" id="solucoes" aria-labelledby="solutions-title">
      <div class="section-heading"><p class="eyebrow">01 / O QUE CONSTRUÍMOS</p><div><h2 id="solutions-title">Seu próximo passo.<br /><span>Construído com inteligência.</span></h2><p>Unimos estratégia, design e engenharia para criar tecnologia que se encaixa na sua operação.</p></div></div>
      <div class="solution-grid">
        {solutions.map((solution) => <article class={`solution solution-${solution.kind}`}>
          <div class="solution-top"><span class="mono">/{solution.n}</span><span class="solution-icon" aria-hidden="true">↗</span></div>
          <div class={`solution-art ${solution.kind}`} aria-hidden="true">
            {solution.kind === 'agents' && <><div class="agent-orb">A</div><div class="agent-message"><span class="tiny-label">AGENTE ALIACODE</span><span>Como posso simplificar seu dia?</span><div class="mini-wave">{Array.from({length: 24},(_, i) => <i style={`--h:${8 + (Math.sin(i * 1.8) + 1) * 12}px`}></i>)}</div></div></>}
            {solution.kind === 'flows' && <><span class="flow-node">↳</span><span class="flow-connector"></span><span class="flow-node main-node">✳</span><span class="flow-connector"></span><div class="flow-ends"><span>Dados</span><span>Ação <b>↗</b></span><span>Resultado</span></div></>}
            {solution.kind === 'software' && <div class="code-window"><div class="window-bar"><i></i><i></i><i></i><span>seu próximo produto</span></div><div class="code-lines"><span><em>const</em> ideia = seuNegócio;</span><span><em>const</em> solução = <strong>criar</strong>({'{'}</span><span class="indent">estratégia, design, tecnologia</span><span>{'}'});<b class="cursor"></b></span></div></div>}
            {solution.kind === 'data' && <div class="data-viz"><div class="data-caption"><span>INFORMAÇÃO → CLAREZA</span><span>↗</span></div><div class="bars">{[23,37,29,49,42,56,65,53,72,67,83,96].map((height) => <span style={`--bar:${height}%`}></span>)}</div><div class="data-baseline"><span>CONTEXTO</span><span>DECISÃO</span></div></div>}
          </div>
          <h3>{solution.title}</h3><p>{solution.text}</p><ul class="tags" aria-label="Aplicações">{solution.tags.map(tag => <li>{tag}</li>)}</ul>
        </article>)}
      </div>
    </section>

    <section class="possibilities section wrap" id="possibilidades" aria-labelledby="possibilities-title">
      <div class="section-heading"><p class="eyebrow">02 / IA NA PRÁTICA</p><div><h2 id="possibilities-title">Menos tarefas repetitivas.<br /><span>Mais possibilidades.</span></h2><p>Veja como a inteligência artificial pode fazer parte dos processos da sua empresa.</p></div></div>
      <div class="scenario-buttons" role="group" aria-label="Escolha um exemplo de aplicação"><button data-scenario="atendimento" aria-pressed="true">Atendimento <span>↗</span></button><button data-scenario="operacao" aria-pressed="false">Operação <span>↗</span></button><button data-scenario="conhecimento" aria-pressed="false">Conhecimento <span>↗</span></button></div>
      <div class="scenario-stage">
        <div class="scenario-copy" aria-live="polite" aria-atomic="true"><span class="tiny-label" id="scenario-label">ATENDIMENTO COM CONTEXTO</span><h3 id="scenario-title">Cada conversa,<br />um próximo passo.</h3><p id="scenario-description">Um agente consulta a base da empresa, entende a solicitação e encaminha o que precisa de uma pessoa. Sua equipe entra onde faz mais diferença.</p><ul id="scenario-benefits"><li>Respostas conectadas à sua base</li><li>Integração com canais e sistemas</li><li>Encaminhamento para a equipe</li></ul></div>
        <div class="scenario-diagram"><div class="diagram-caption"><span class="status-dot"></span> EXEMPLO DE APLICAÇÃO</div><div class="diagram-input"><span class="tiny-label">01 / ENTRADA</span><p id="scenario-input">“Qual é o status do meu pedido?”</p></div><div class="diagram-line"></div><div class="diagram-engine"><span class="engine-symbol">Λ</span><div><strong>Inteligência AliaCode</strong><span id="scenario-action">Entender · Consultar · Responder</span></div><span class="engine-spark">✳</span></div><div class="diagram-line"></div><div class="diagram-output"><span class="tiny-label">02 / PRÓXIMO PASSO</span><p id="scenario-output">Informação encontrada. Resposta preparada com os dados do pedido.</p><span class="output-tag" id="scenario-tag">Regras da sua operação</span></div></div>
      </div>
      <p class="demo-note">Fluxo ilustrativo. Cada solução é desenvolvida conforme o contexto, os dados e as regras do projeto.</p>
    </section>

    <section class="process-light" id="processo" aria-labelledby="process-title"><div class="wrap section">
      <div class="section-heading"><p class="eyebrow">03 / COMO TRABALHAMOS</p><div><h2 id="process-title">Do primeiro porquê<br />ao próximo passo.</h2><p>Proximidade em cada etapa. Clareza para construir. Espaço para evoluir.</p></div></div>
      <div class="process-grid">{steps.map(([title, subtitle, text], i) => <article><div class="process-number"><span>0{i + 1}</span><Arrow /></div><h3>{title}<span>.</span></h3><h4>{subtitle}</h4><p>{text}</p></article>)}</div>
      <div class="process-bottom"><span>SEU CONTEXTO. NOSSA ENGENHARIA.</span><p>Uma parceria do início à evolução.</p></div>
    </div></section>

    <section class="about section wrap" id="sobre" aria-labelledby="about-title"><p class="eyebrow">04 / SOMOS ALIACODE</p><div class="about-layout"><h2 id="about-title">A tecnologia avança.<br /><span>Sua empresa também.</span></h2><div class="about-copy"><p>Somos uma software house que desenvolve soluções de inteligência artificial para empresas.</p><p>Acreditamos que a melhor tecnologia é a que resolve um problema real. Por isso, começamos pelo seu contexto e conectamos ideias, pessoas e código para construir o que vem a seguir.</p><div class="principles"><span>Visão de negócio</span><span>Engenharia sob medida</span><span>Evolução contínua</span></div></div></div></section>

    <section class="faq wrap" aria-labelledby="faq-title"><div><p class="eyebrow">ANTES DO PRÓXIMO PASSO</p><h2 id="faq-title">Boas perguntas.<br /><span>Respostas claras.</span></h2></div><div class="faq-list">{questions.map(([question, answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
    <section class="closing wrap"><p class="eyebrow">DA IDEIA AO IMPACTO.</p><h2>O futuro se constrói<span>.</span></h2><a class="text-link" href="#solucoes">Explore o que podemos construir <Arrow diagonal /></a></section>
  </main>
  <footer class="site-footer wrap"><a class="footer-wordmark" href="#inicio" aria-label="AliaCode — voltar ao início"><Logo large /></a><div class="footer-meta"><p>© {new Date().getFullYear()} AliaCode. Todos os direitos reservados.</p><span>INTELIGÊNCIA APLICADA. POSSIBILIDADES REAIS.</span><a href="#inicio">Voltar ao topo ↑</a></div></footer>

  <script>
    const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const navigation = document.querySelector<HTMLElement>('#main-nav');
    function closeMenu() { menu?.setAttribute('aria-expanded', 'false'); menu?.setAttribute('aria-label', 'Abrir menu'); navigation?.classList.remove('is-open'); }
    menu?.addEventListener('click', () => { const open = menu.getAttribute('aria-expanded') !== 'true'; menu.setAttribute('aria-expanded', String(open)); menu.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu'); navigation?.classList.toggle('is-open', open); });
    navigation?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
    document.addEventListener('keydown', event => { if(event.key === 'Escape' && menu?.getAttribute('aria-expanded') === 'true') { closeMenu(); menu.focus(); } });
    document.addEventListener('click', event => { if(event.target instanceof Node && !navigation?.contains(event.target) && !menu?.contains(event.target)) closeMenu(); });
    matchMedia('(min-width: 901px)').addEventListener('change', closeMenu);
    const scenarios = {
      atendimento: { label: 'ATENDIMENTO COM CONTEXTO', title: 'Cada conversa, um próximo passo.', description: 'Um agente consulta a base da empresa, entende a solicitação e encaminha o que precisa de uma pessoa. Sua equipe entra onde faz mais diferença.', benefits: ['Respostas conectadas à sua base', 'Integração com canais e sistemas', 'Encaminhamento para a equipe'], input: '“Qual é o status do meu pedido?”', action: 'Entender · Consultar · Responder', output: 'Informação encontrada. Resposta preparada com os dados do pedido.', tag: 'Regras da sua operação' },
      operacao: { label: 'PROCESSOS QUE SE CONECTAM', title: 'Do trabalho manual ao fluxo inteligente.', description: 'Uma informação chega, os dados são organizados e a próxima tarefa segue para o sistema certo. Sua equipe acompanha as exceções e mantém o controle.', benefits: ['Menos etapas manuais', 'Sistemas conectados por integrações', 'Aprovação humana quando necessária'], input: 'Um novo documento chega à operação.', action: 'Ler · Organizar · Integrar', output: 'Dados extraídos e organizados para revisão e atualização do sistema.', tag: 'Revisão antes de executar' },
      conhecimento: { label: 'CONHECIMENTO AO ALCANCE', title: 'A resposta certa começa nos seus dados.', description: 'Transforme documentos e informações dispersas em uma base consultável. Um assistente ajuda sua equipe a encontrar respostas com o contexto da empresa.', benefits: ['Consulta a documentos internos', 'Respostas com referência à fonte', 'Acesso conforme as permissões'], input: '“Como funciona este procedimento?”', action: 'Buscar · Contextualizar · Explicar', output: 'Orientação preparada a partir dos documentos disponíveis, com as fontes para consulta.', tag: 'Conhecimento da sua empresa' },
    };
    document.querySelectorAll<HTMLButtonElement>('[data-scenario]').forEach(button => button.addEventListener('click', () => {
      const key = button.dataset.scenario as keyof typeof scenarios;
      const scenario = scenarios[key];
      if(!scenario) return;
      document.querySelectorAll('[data-scenario]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      for(const field of ['label', 'title', 'description', 'input', 'action', 'output', 'tag'] as const) { const element = document.getElementById(`scenario-${field}`); if(element) element.textContent = scenario[field]; }
      const benefits = document.getElementById('scenario-benefits');
      benefits?.replaceChildren(...scenario.benefits.map(text => { const li = document.createElement('li'); li.textContent = text; return li; }));
    }));
  </script>
</Layout>
