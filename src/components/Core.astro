---
const rings = Array.from({length: 48}, (_, i) => ({ r: 100 + i * 3.45, opacity: .15 + .5 * Math.pow(Math.sin(i / 47 * Math.PI), 2) }));
---
<div class="core-art" aria-hidden="true">
  <div class="core-halo"></div>
  <svg class="core-orbit" viewBox="0 0 640 640" fill="none">
    <defs>
      <linearGradient id="silver" x1="100" y1="100" x2="500" y2="500" gradientUnits="userSpaceOnUse"><stop stop-color="#ececec"/><stop offset=".32" stop-color="#808080"/><stop offset=".55" stop-color="#232323"/><stop offset=".8" stop-color="#a4a4a4"/><stop offset="1" stop-color="#dddddd"/></linearGradient>
      <radialGradient id="core-glow"><stop stop-color="#1a1a1a"/><stop offset="1" stop-color="#060606"/></radialGradient>
    </defs>
    <circle cx="320" cy="320" r="94" fill="url(#core-glow)"/>
    <g class="orbit-rings">
      {rings.map(({r, opacity}, i) => <ellipse cx="320" cy="320" rx={r} ry={r * (.83 + .15 * Math.sin(i / 15))} transform={`rotate(${i * 2.2 - 52} 320 320)`} stroke="url(#silver)" stroke-width={i % 9 === 0 ? 1.3 : .65} opacity={opacity} />)}
    </g>
    <circle cx="320" cy="320" r="287" stroke="#393939" stroke-dasharray="1 11"/>
    <path d="M320 11v21M320 608v21M11 320h21M608 320h21" stroke="#575757"/>
    <path d="m277 357 36-78h14l36 78h-18l-25-55-25 55Z" fill="#f2f2f2"/>
    <circle cx="543" cy="185" r="4" fill="#dedede"/>
    <circle cx="111" cy="492" r="3" fill="#dedede"/>
  </svg>
  <span class="art-note note-top">IDEIA → INTELIGÊNCIA</span>
  <span class="art-note note-bottom">CÓDIGO → POSSIBILIDADE</span>
</div>
